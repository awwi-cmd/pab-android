<?xml version="1.0" encoding="utf-8"?>
<!-- DECISIONS D-082: the native Android launch screen, shown while the
     process starts and the Flutter engine loads, before the first frame
     draws. splash_bg.png (drawable-nodpi, so it's never density-scaled
     before this layer stretches it to the screen) fills the whole window. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/splash_bg" />
</layer-list>
